# --- Auto Ticket Router Environment Variables ---

# [Database]
# Local dev: postgresql://postgres@localhost:5432/ticket_router
# Docker compose: postgresql://postgres:password123@postgres:5432/ticket_router
DATABASE_URL=postgresql://postgres:password123@postgres:5432/ticket_router

# [Redis]
# Local dev: localhost
# Docker compose: redis
REDIS_URL=redis

# [Security]
# Change this to a secure random string for production
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=super-secret-jwt-key-change-me

# [CORS]
# Allowed origins for the FastAPI backend. Use commas for multiple origins.
# Use '*' for development/testing, but specify exact domain in production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
